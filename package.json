{
  "name": "azure-argus",
  "version": "0.6.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "geoip:update": "bun scripts/update-ip-country-database.ts",
    "preview": "nuxt preview",
    "lint": "bun run lint:ox && bun run lint:vue",
    "lint:ox": "oxlint",
    "lint:vue": "eslint --max-warnings 0 --cache --cache-location node_modules/.cache/eslint/ '**/*.vue'",
    "lint:fix": "oxlint --fix && eslint --fix --cache --cache-location node_modules/.cache/eslint/ '**/*.vue'",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "nuxt typecheck",
    "test:unit": "vitest run --project unit --project nuxt",
    "test:browser": "node -e \"if (!process.env.PLAYWRIGHT_EXECUTABLE_PATH) { console.error('PLAYWRIGHT_EXECUTABLE_PATH must point to the Nix-wrapped Chromium executable.'); process.exit(1); }\" && vitest run --project browser",
    "test:e2e": "playwright test",
    "bump": "bunx taze major --maturity-period -w",
    "prepare": "if command -v git >/dev/null 2>&1; then lefthook install; fi"
  },
  "dependencies": {
    "@azure/event-hubs": "^6.0.4",
    "@azure/msal-browser": "5.17.0",
    "@maxmind/geoip2-node": "7.0.0",
    "@nuxt/ui": "^4.12.0",
    "buffer": "^6.0.3",
    "nuxt": "^4.6.4",
    "nuxt-oidc-auth": "^1.0.0-beta.12",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "tailwindcss": "^4.3.2",
    "vue": "^3.5.45",
    "vue-virtual-scroller": "^3.0.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@iconify-json/lucide": "^1.2.116",
    "@nuxt/test-utils": "4.0.3",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@visorian/code-standards": "^0.7.0",
    "@vitest/browser-playwright": "4.1.10",
    "@vue/test-utils": "2.4.11",
    "eslint": "^10.11.0",
    "happy-dom": "20.10.6",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.17.tsgo.7.0.2",
    "vite": "^8.3.6",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.17.tsgo.7.0.2",
    "vite": "^8.3.6"
  },
  "packageManager": "bun@1.3.14"
}
