{
  "name": "azure-argus",
  "version": "0.5.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "geoip:update": "bun scripts/update-ip-country-database.ts",
    "preview": "nuxt preview",
    "lint": "bun run lint:ox && bun run lint:vue",
    "lint:ox": "oxlint",
    "lint:vue": "eslint --max-warnings 0 --cache --cache-location node_modules/.cache/eslint/ '**/*.vue'",
    "lint:fix": "oxlint --fix && eslint --fix --cache --cache-location node_modules/.cache/eslint/ '**/*.vue'",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "nuxt typecheck",
    "test:unit": "vitest run --project unit --project nuxt",
    "test:browser": "node -e \"if (!process.env.PLAYWRIGHT_EXECUTABLE_PATH) { console.error('PLAYWRIGHT_EXECUTABLE_PATH must point to the Nix-wrapped Chromium executable.'); process.exit(1); }\" && vitest run --project browser",
    "test:e2e": "playwright test",
    "bump": "bunx taze major --maturity-period -w",
    "prepare": "if command -v git >/dev/null 2>&1; then lefthook install; fi"
  },
  "dependencies": {
    "@azure/event-hubs": "^6.0.4",
    "@azure/msal-browser": "5.30.0",
    "@maxmind/geoip2-node": "7.1.0",
    "@nuxt/ui": "^4.13.0",
    "buffer": "^6.0.3",
    "nuxt": "^4.6.4",
    "nuxt-oidc-auth": "^1.0.0-beta.13",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.46",
    "vue-virtual-scroller": "^3.0.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@iconify-json/lucide": "^1.2.157",
    "@nuxt/test-utils": "4.4.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@visorian/code-standards": "^0.9.0",
    "@vitest/browser-playwright": "4.1.12",
    "@vue/test-utils": "2.6.0",
    "eslint": "^10.15.0",
    "happy-dom": "21.0.4",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.19.tsgo.7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.19.tsgo.7.0.2",
    "vite": "^8.3.8"
  },
  "packageManager": "bun@1.4.4"
}
